<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:2rem;background:#f5f5f3;font-family:Inter,Arial,sans-serif;color:#1b1b1b;">
    <div style="max-width:32rem;margin:0 auto;background:#ffffff;border:1px solid #e4e4e0;border-radius:0.5rem;padding:2rem;">
        <p style="font-family:'Patua One',Georgia,serif;font-size:1.5rem;margin:0 0 1.5rem;color:#5b7f3a;">MossyTrunk</p>
        {% block content %}{% endblock %}
        <p style="margin:2rem 0 0;font-size:0.8rem;color:#6f6f6b;">
            {{ 'layout.copy_link'|trans({}, 'emails') }}<br>
            <a href="{{ url }}" style="color:#5b7f3a;word-break:break-all;">{{ url }}</a>
        </p>
    </div>
</body>
</html>
