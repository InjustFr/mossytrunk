{% extends 'email/layout.html.twig' %}

{% block content %}
    <p>{{ 'greeting'|trans({}, 'emails') }}</p>
    <p>{{ 'invitation.intro'|trans({workspace: '<strong>' ~ workspace|e ~ '</strong>'}, 'emails')|raw }}</p>
    <p>{{ 'invitation.instructions'|trans({}, 'emails') }}</p>
    <p style="margin:1.5rem 0;">
        <a href="{{ url }}" style="background:#5b7f3a;color:#ffffff;padding:0.75rem 1.25rem;border-radius:0.5rem;text-decoration:none;display:inline-block;">{{ 'invitation.button'|trans({}, 'emails') }}</a>
    </p>
    <p style="font-size:0.9rem;color:#6f6f6b;">{{ 'invitation.expiry'|trans({expiresAt: expiresAt|date('expiry_format'|trans({}, 'emails'), 'Europe/Paris')}, 'emails') }}</p>
{% endblock %}
